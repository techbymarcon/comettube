<?xml version="1.0" encoding="utf-8"?>
<!-- CometTube Home shell. One floating liquid glass bottom nav (Home / Subscriptions / History / You)
     is the structural navigation. Top bar features the crisp Comet brand banner, sub-screen navigation,
     Cast picker and search entry. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_browse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/newtubeColorBackground">

    <!-- CometTube: Liquid Glass Top Bar (Header) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mobile_top_bar_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/mobile_title_bar_height"
        android:background="@drawable/bg_liquid_top_bar"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/mobile_title_back"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_dialog_back"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_back_arrow"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/mobile_title_banner"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="16dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/ic_comet_banner"
            app:layout_constraintStart_toEndOf="@id/mobile_title_back"
            app:layout_constraintEnd_toStartOf="@id/mobile_cast_button"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/mobile_title_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:text="@string/app_name"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="20sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/mobile_title_back"
            app:layout_constraintEnd_toStartOf="@id/mobile_cast_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/mobile_cast_button"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_cast_button"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_cast"
            app:layout_constraintEnd_toStartOf="@id/mobile_search_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/mobile_search_button"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mobile_search_button"
            android:padding="12dp"
            android:src="@drawable/ic_mobile_search"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Pull-to-refresh drives BrowsePresenter.refresh(). Full bleed scrolling under the floating liquid glass dock. -->
    <com.newtube.mobile.ui.common.HapticSwipeRefreshLayout
        android:id="@+id/mobile_content_swipe"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_top_bar_container">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mobile_content_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/mobile_card_spacing"
            android:paddingBottom="96dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_video_card" />

    </com.newtube.mobile.ui.common.HapticSwipeRefreshLayout>

    <include
        layout="@layout/mobile_feed_skeleton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_top_bar_container" />

    <LinearLayout
        android:id="@+id/mobile_error_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_top_bar_container">

        <ImageView
            android:id="@+id/mobile_error_icon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_mobile_empty" />

        <TextView
            android:id="@+id/mobile_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/mobile_color_on_surface"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mobile_error_action"
            style="@style/Widget.NewTube.Button.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- "You" tab: account row, every enabled BrowsePresenter section that isn't in the bottom nav, then Settings. -->
    <ScrollView
        android:id="@+id/mobile_you_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/newtubeColorBackground"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mobile_top_bar_container"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <!-- Account header -->
            <LinearLayout
                android:id="@+id/mobile_you_account_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="20dp">

                <ImageView
                    android:id="@+id/mobile_you_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mobile_account" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mobile_you_account_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/dialog_add_account"
                        android:textColor="@color/mobile_color_on_surface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mobile_you_account_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/mobile_color_on_surface_secondary"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="8dp"
                android:background="@color/mobile_color_divider" />

            <LinearLayout
                android:id="@+id/mobile_you_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- FLOATING mini-player: hovering over content above the liquid glass navbar dock. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mobile_mini_player"
        android:contentDescription="@string/mobile_mini_expand"
        android:layout_width="180dp"
        android:layout_height="102dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/black"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="#30FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/mobile_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.media3.ui.AspectRatioFrameLayout
                android:id="@+id/mobile_mini_player_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/mobile_mini_freeze"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:visibility="gone" />

            </androidx.media3.ui.AspectRatioFrameLayout>

            <ImageButton
                android:id="@+id/mobile_mini_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mini_scrim_circle"
                android:contentDescription="@string/mobile_mini_play_pause"
                android:padding="9dp"
                android:src="@drawable/ic_player_pause" />

            <ImageButton
                android:id="@+id/mobile_mini_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="0dp"
                android:background="@drawable/bg_mini_scrim_circle_touch"
                android:contentDescription="@string/mobile_mini_close"
                android:padding="15dp"
                android:src="@drawable/ic_sheet_close"
                android:tint="@color/mobile_player_on_video" />

            <ProgressBar
                android:id="@+id/mobile_mini_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:max="1000"
                android:progressBackgroundTint="@color/mobile_color_progress_track"
                android:progressTint="@color/mobile_color_progress"
                tools:progress="400" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- CometTube: 1:1 iOS Liquid Glass Floating Pill Dock Navbar -->
    <com.newtube.mobile.ui.common.LiquidBottomNavigationView
        android:id="@+id/mobile_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:background="@android:color/transparent"
        app:elevation="14dp"
        app:itemRippleColor="@android:color/transparent"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/mobile_bottom_nav_item"
        app:itemTextAppearanceActive="@style/MobileBottomNavText"
        app:itemTextAppearanceActiveBoldEnabled="false"
        app:itemTextAppearanceInactive="@style/MobileBottomNavText"
        app:itemTextColor="@color/mobile_bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:layout_constraintWidth_max="420dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
