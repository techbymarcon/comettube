<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shorts_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:visibility="gone">

    <!-- Top Scrim Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_shorts_scrim_top" />

    <!-- Bottom Scrim Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_shorts_scrim_bottom" />

    <!-- Top Controls Area -->
    <LinearLayout
        android:id="@+id/shorts_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shorts_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:text="Shorts"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/shorts_btn_mute"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_settings_player_volume"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_volume_up"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/shorts_btn_subtitles"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_player_subtitles"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_cc"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/shorts_btn_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_hint"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mobile_search"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/shorts_btn_more"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_player_settings"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mobile_more_vert"
                app:tint="@android:color/white" />

        </LinearLayout>

        <!-- Topic Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/shorts_chip_subscriptions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_shorts_chip"
                    android:drawableStart="@drawable/ic_nav_subscriptions_outline"
                    android:drawablePadding="6dp"
                    android:drawableTint="@android:color/white"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Iscrizioni"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shorts_chip_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_shorts_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Live"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shorts_chip_lens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_shorts_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Lens"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Right Side Actions Column (Floating above bottom navigation) -->
    <LinearLayout
        android:id="@+id/shorts_actions_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="60dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Like Button -->
        <LinearLayout
            android:id="@+id/shorts_action_like_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/shorts_btn_like"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_watch_like"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shorts_heart" />

            <TextView
                android:id="@+id/shorts_text_like_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="675K"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Comments Button -->
        <LinearLayout
            android:id="@+id/shorts_action_comments_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/shorts_btn_comment"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_comments_title"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shorts_comment" />

            <TextView
                android:id="@+id/shorts_text_comment_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="2126"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Share Button -->
        <LinearLayout
            android:id="@+id/shorts_action_share_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/shorts_btn_share"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_watch_share"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shorts_share" />

            <TextView
                android:id="@+id/shorts_text_share_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="Condividi"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Remix Button -->
        <LinearLayout
            android:id="@+id/shorts_action_remix_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/shorts_btn_remix"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remix"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_shorts_remix" />

            <TextView
                android:id="@+id/shorts_text_remix_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="6"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Sound Disc -->
        <FrameLayout
            android:id="@+id/shorts_action_sound_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/shorts_img_sound_disc"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shorts_sound_disc" />

        </FrameLayout>

    </LinearLayout>

    <!-- Bottom-Left Metadata Overlay -->
    <LinearLayout
        android:id="@+id/shorts_meta_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="30dp"
        android:orientation="vertical">

        <!-- Badge -->
        <TextView
            android:id="@+id/shorts_meta_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_shorts_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="Doppiaggio automatico"
            android:textColor="#E6FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Channel Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/shorts_channel_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_mobile_account" />

            <TextView
                android:id="@+id/shorts_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="\@Channel"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shorts_btn_subscribe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_shorts_subscribe"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Iscriviti"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Video Title -->
        <TextView
            android:id="@+id/shorts_video_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Shorts Video Title goes here"
            android:textColor="@android:color/white"
            android:textSize="14.5sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="normal" />

        <!-- Sound Track Audio Pill -->
        <LinearLayout
            android:id="@+id/shorts_audio_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_shorts_audio_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="▶"
                android:textColor="@android:color/white"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/shorts_audio_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:singleLine="true"
                android:text="Original Sound"
                android:textColor="@android:color/white"
                android:textSize="11.5sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Playback Scrubber & Red Progress Bar -->
    <FrameLayout
        android:id="@+id/shorts_progress_container"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="4dp">

        <ProgressBar
            android:id="@+id/shorts_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="center_vertical"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/shorts_progress_drawable" />

        <View
            android:id="@+id/shorts_progress_thumb"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_shorts_thumb"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>
