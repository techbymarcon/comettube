<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- STEP 1: INTRO & LOGO ANIMATION -->
    <RelativeLayout
        android:id="@+id/step_intro"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/center_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Logo that slides down from top -->
            <ImageView
                android:id="@+id/intro_logo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_comet_logo" />

            <!-- Text container that fades in after logo lands -->
            <LinearLayout
                android:id="@+id/intro_text_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:alpha="0"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_welcome_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="welcome to"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="normal" />

                <ImageView
                    android:id="@+id/intro_comet_text"
                    android:layout_width="220dp"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_comet_text" />

                <TextView
                    android:id="@+id/txt_tube"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="0.08"
                    android:text="Tube"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Proceed button that pops in 1 second later -->
        <FrameLayout
            android:id="@+id/btn_proceed_intro"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="56dp"
            android:alpha="0"
            android:background="@drawable/bg_liquid_glass_proceed"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:letterSpacing="0.04"
                android:text="Proceed"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </FrameLayout>

    </RelativeLayout>

    <!-- STEP 2: CHOOSE THEME -->
    <LinearLayout
        android:id="@+id/step_theme"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="72dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/title_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="Choose your theme"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sub_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Pure OLED black or soft premium white"
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Dark Theme Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_theme_dark"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#121212"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#007AFF"
                app:strokeWidth="2.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌙"
                        android:textSize="32sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dark"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pure Black (Recommended)"
                            android:textColor="#8E8E93"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/check_dark"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mobile_check"
                        android:tint="#007AFF"
                        android:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Light Theme Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_theme_light"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="18dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1C1C1E"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☀️"
                        android:textSize="32sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Light"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Soft Premium White"
                            android:textColor="#8E8E93"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/check_light"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mobile_check"
                        android:tint="#007AFF"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Proceed Button -->
        <FrameLayout
            android:id="@+id/btn_proceed_theme"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginBottom="56dp"
            android:background="@drawable/bg_liquid_glass_proceed"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txt_btn_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:letterSpacing="0.04"
                android:text="Proceed"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </FrameLayout>

    </LinearLayout>

    <!-- STEP 3: CHOOSE LANGUAGE -->
    <LinearLayout
        android:id="@+id/step_language"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:visibility="gone">

        <!-- Rotating Globe Icon -->
        <ImageView
            android:id="@+id/iv_rotating_globe"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_setup_globe" />

        <TextView
            android:id="@+id/title_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.02"
            android:text="Choose your language"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Language list container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#141416"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#25FFFFFF"
            app:strokeWidth="1dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/language_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

        </com.google.android.material.card.MaterialCardView>

        <!-- Proceed Button -->
        <FrameLayout
            android:id="@+id/btn_proceed_language"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginBottom="44dp"
            android:background="@drawable/bg_liquid_glass_proceed"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:letterSpacing="0.04"
                android:text="Proceed"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </FrameLayout>

    </LinearLayout>

    <!-- STEP 4: FINAL WELCOME SCREEN -->
    <FrameLayout
        android:id="@+id/step_welcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_final_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:letterSpacing="0.04"
            android:text="Welcome."
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

    </FrameLayout>

</FrameLayout>
